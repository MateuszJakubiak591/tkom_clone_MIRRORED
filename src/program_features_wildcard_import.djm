import * from "program_features_number_library.djm"

fun main() -> int {
   int fib = program_features_number_library.fibonacci(8)
   int fact = program_features_number_library.factorial(5)
   int squared = program_features_number_library.square(6)

   println(program_features_number_library.DEFAULT_LIMIT)
   println(fib)
   println(fact)
   println(squared)

   return fib
}
