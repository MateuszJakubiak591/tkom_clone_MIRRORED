// Wspolna biblioteka uzywana przez rozbudowane programy demonstracyjne.
// Udostepnia funkcje operujace na liczbach i listach. Funkcje pomocnicze nie
// musza byc importowane przez program glowny, ale sa widoczne wewnatrz modulu.

int DEFAULT_LIMIT = 8

fun square(value: int) -> int {
   return value * value
}

fun cube(value: int) -> int {
   return value * value * value
}

fun sum(values: list<int>) -> int {
   mut int total = 0
   for int value in values {
      total = total + value
   }
   return total
}

fun factorial(value: int) -> int {
   if value <= 1 {
      return 1
   }
   return value * factorial(value - 1)
}

fun fibonacci(value: int) -> int {
   if value <= 1 {
      return value
   }
   return fibonacci(value - 1) + fibonacci(value - 2)
}
