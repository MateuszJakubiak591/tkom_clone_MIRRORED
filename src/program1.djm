int DEFAULT_A = 3
int DEFAULT_B = 7

fun fib(n: int) -> int {
   if n <= 1 {
      return n
   }
   return fib(n - 1) + fib(n - 2)
}

fun average(a: int, b: int) -> float {
   return (a + b) as float / 2.0
}

fun median3(a: int, b: int, c: int) -> int {
   if a > b {
      if b > c {
         return b
      }
      if a > c {
         return c
      }
      return a
   }
   if a > c {
      return a
   }
   if b > c {
      return c
   }
   return b
}

fun main() -> int {
   int m = median3(DEFAULT_A, DEFAULT_B, fib(5))
   return m
}